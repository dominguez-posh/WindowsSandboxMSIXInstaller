<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSIX Sandbox Studio" Width="1280" Height="840" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        AllowDrop="True">
    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,28">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MSIX Sandbox" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="STUDIO" FontSize="10" Foreground="{StaticResource Accent2}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" CornerRadius="10" Background="#121A31" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SandboxDot" Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SandboxStateText" Text="Sandbox idle" FontSize="12"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Text="v2.0.0" FontSize="11" Foreground="{StaticResource Muted}" Margin="16,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True"/>
                    <RadioButton x:Name="NavRecipes" Style="{StaticResource Nav}" Tag="&#xE8FD;" Content="Recipes"/>
                    <RadioButton x:Name="NavPackages" Style="{StaticResource Nav}" Tag="&#xE7B8;" Content="Packages"/>
                    <RadioButton x:Name="NavCertificate" Style="{StaticResource Nav}" Tag="&#xEB95;" Content="Certificate"/>
                    <RadioButton x:Name="NavIntune" Style="{StaticResource Nav}" Tag="&#xE753;" Content="Intune"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="32,24,32,16">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="PageSubtitle" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="BusyPill" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="14,7"
                        Background="#1B2547" BorderBrush="{StaticResource Accent}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BusySpinner" Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent2}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform x:Name="SpinnerRotate" Angle="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="BusyText" Text="Working ..." FontSize="12" MaxWidth="480" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
            <ProgressBar x:Name="BusyBar" Grid.Row="1" IsIndeterminate="True" Visibility="Hidden" Margin="32,0"/>

            <!-- Pages -->
            <Grid Grid.Row="2" Margin="32,12,32,0">

                <!-- ===== Dashboard ===== -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border CornerRadius="16" Background="{StaticResource HeroGradient}" Padding="28,24" Margin="0,0,0,16" BorderBrush="#3B2F8F" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Installer in, signed and tested MSIX out." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Every run starts in a fresh Windows Sandbox: clean capture, nothing left behind on your machine."
                                               Foreground="#C7D2FE" Margin="0,6,0,18" TextWrapping="Wrap"/>
                                    <WrapPanel x:Name="PipelineChips"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button x:Name="BtnDashRecord" Tag="&#xE7C8;" Content="Record installation" Margin="0,0,0,8"
                                            ToolTip="Opens the MSIX Recorder in a sandbox: Start recording, install the app, Stop recording"/>
                                    <Button x:Name="BtnDashNewRecipe" Tag="&#xE710;" Content="New recipe" Style="{StaticResource Ghost}" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnDashSandbox" Tag="&#xE7F4;" Content="Open sandbox" Style="{StaticResource Ghost}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Readiness" Style="{StaticResource H2}"/>
                        <UniformGrid x:Name="ReadinessGrid" Columns="3"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recipes" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="StatRecipes" Text="0" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Packages in output" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="StatPackages" Text="0" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Recipes ===== -->
                <Grid x:Name="PageRecipes" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnRecipeNew" Tag="&#xE710;" Content="New"/>
                            <Button x:Name="BtnRecipeRefresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource Ghost}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" Margin="0,8,0,16">
                            <TextBlock Text="Tip: drop an .msi or .exe anywhere on this window to start a recipe." Style="{StaticResource Hint}"/>
                        </Border>
                        <ListBox x:Name="RecipeList"/>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="RecipeEditorTitle" Text="New recipe" Style="{StaticResource H2}"/>
                                        <Border x:Name="FrameworkBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="10,3" Background="#1B2547" Visibility="Collapsed">
                                            <TextBlock x:Name="FrameworkText" FontSize="11" Foreground="{StaticResource Accent2}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Installation" Style="{StaticResource Label}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeSilent" Style="{StaticResource Chip}" GroupName="InstallMode" IsChecked="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Silent (unattended)"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="ModeManual" Style="{StaticResource Chip}" GroupName="InstallMode">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Manual (record my installation)"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                    <Border x:Name="ManualInfo" CornerRadius="8" Background="#1B2547" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource Hint}" Foreground="#C7D2FE"
                                                   Text="A sandbox opens with the MSIX Recorder and installs everything by itself. Click 'Start recording' there (your installer starts automatically), install and configure the app, click 'Stop recording': the package is built, copied back and signed."/>
                                    </Border>
                                    <TextBlock x:Name="LblInstaller" Text="Installer (.msi / .exe)" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button x:Name="BtnRecipeBrowse" DockPanel.Dock="Right" Tag="&#xE838;" Content="Browse" Style="{StaticResource Ghost}" Margin="8,0,0,0"/>
                                        <TextBox x:Name="TxtInstaller"/>
                                    </DockPanel>
                                    <StackPanel x:Name="ArgumentsPanel">
                                        <TextBlock Text="Silent arguments (EXE only; MSI runs silently by itself)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtArguments" FontFamily="Cascadia Mono, Consolas"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Package name (identity)" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="TxtPackageName"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Version (x.x.x.x)" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="TxtVersion"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Display name" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="TxtDisplayName"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Publisher display name" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="TxtPublisherDisplay"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Description" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtDescription"/>
                                    <TextBlock Text="Install location (optional, e.g. C:\Program Files\Vendor\App)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtInstallLocation"/>
                                    <TextBlock x:Name="TxtPublisherHint" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="BtnRecipeSave" Tag="&#xE74E;" Content="Save" Style="{StaticResource Ghost}"/>
                                        <Button x:Name="BtnRecipeDelete" Tag="&#xE74D;" Content="Delete" Style="{StaticResource DangerGhost}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Build" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="BuildHint" Text="Saves the recipe, then runs the steps unattended. Each sandbox closes by itself when it is done."
                                               Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnBuild" Tag="&#xE7B8;" Content="Package + sign" Margin="0,0,8,8"/>
                                        <Button x:Name="BtnBuildTest" Tag="&#xEBE8;" Content="Package + sign + test" Margin="0,0,8,8"/>
                                        <Button x:Name="BtnBuildAll" Tag="&#xE945;" Content="Full pipeline to Intune" Style="{StaticResource Ghost}" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Packages ===== -->
                <Grid x:Name="PagePackages" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnPkgRefresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource Ghost}"/>
                            <Button x:Name="BtnPkgAdd" Tag="&#xE710;" Content="Add .msix" Style="{StaticResource Ghost}"/>
                            <Button x:Name="BtnPkgFolder" Tag="&#xE838;" Content="Folder" Style="{StaticResource Ghost}"/>
                        </StackPanel>
                        <ListBox x:Name="PackageList" Margin="0,0,0,16"/>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="PkgTitle" Text="Select a package" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="PkgDetails" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button x:Name="BtnPkgTest" Tag="&#xEBE8;" Content="Test in sandbox" Margin="0,0,8,8" IsEnabled="False"/>
                                        <Button x:Name="BtnPkgSign" Tag="&#xEB95;" Content="Sign again" Style="{StaticResource Ghost}" Margin="0,0,8,8" IsEnabled="False"/>
                                        <Button x:Name="BtnPkgPublish" Tag="&#xE898;" Content="Publish to Intune" Style="{StaticResource Ghost}" Margin="0,0,8,8" IsEnabled="False"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TestCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock x:Name="TestIcon" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"/>
                                        <TextBlock Text="Last test" Style="{StaticResource H2}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TestMessage" TextWrapping="Wrap"/>
                                    <Border CornerRadius="10" ClipToBounds="True" Margin="0,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                        <Image x:Name="TestShot" MaxHeight="420" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnTestPrevShot" Content="&#x25C0;" Style="{StaticResource Small}"/>
                                        <TextBlock x:Name="TestShotLabel" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,12,0"/>
                                        <Button x:Name="BtnTestNextShot" Content="&#x25B6;" Style="{StaticResource Small}"/>
                                        <Button x:Name="BtnTestJob" Tag="&#xE838;" Content="Job folder" Style="{StaticResource Small}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Certificate ===== -->
                <ScrollViewer x:Name="PageCertificate" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentGradient}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xEB95;" Style="{StaticResource Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0">
                                    <TextBlock x:Name="CertSubject" Text="No certificate" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CertDetails" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button x:Name="BtnCertFolder" Tag="&#xE838;" Content="Folder" Style="{StaticResource Ghost}" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnCertIntune" Tag="&#xE753;" Content="Trust via Intune" Style="{StaticResource Ghost}" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Create self-signed" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Subject = publisher of all packages" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtCertSubject" Text="CN="/>
                                    <TextBlock Text="Valid for (years)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtCertYears" Text="5"/>
                                    <TextBlock Text="PFX password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PwdCertNew"/>
                                    <TextBlock Text="Repeat password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PwdCertNew2"/>
                                    <Button x:Name="BtnCertCreate" Tag="&#xE710;" Content="Create" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Import PFX" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Internal CA, public CA or an earlier certificate" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="PFX file" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button x:Name="BtnCertBrowse" DockPanel.Dock="Right" Tag="&#xE838;" Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="10,9"/>
                                        <TextBox x:Name="TxtCertPfx"/>
                                    </DockPanel>
                                    <TextBlock Text="PFX password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PwdCertImport"/>
                                    <Button x:Name="BtnCertImport" Tag="&#xE896;" Content="Import" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Azure Key Vault" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Needs Az.KeyVault; signs in with Connect-AzAccount" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="Vault name" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtKvVault"/>
                                    <TextBlock Text="Certificate name" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="TxtKvCert"/>
                                    <TextBlock Text="Local PFX password" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PwdKv"/>
                                    <Button x:Name="BtnCertKv" Tag="&#xE753;" Content="Fetch" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="The private key stays on this computer: packages are signed on the host, the sandbox only gets the public .cer. The PFX password is stored DPAPI-encrypted for your Windows account."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Intune ===== -->
                <ScrollViewer x:Name="PageIntune" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="12" Background="#1B2547">
                                    <TextBlock Text="&#xE753;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource Accent2}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="IntuneAccount" Text="Not signed in" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IntuneTenant" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtTenant" Width="220" Margin="0,0,8,0" ToolTip="Optional tenant ID or domain"/>
                                    <Button x:Name="BtnIntuneSignIn" Tag="&#xE77B;" Content="Sign in"/>
                                    <Button x:Name="BtnIntuneSignOut" Content="Sign out" Style="{StaticResource Ghost}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Assignment for published apps" Style="{StaticResource H2}"/>
                                <TextBlock Text="Optional. Without a group the app is uploaded but not assigned. Assigning replaces the app's existing assignments."
                                           Style="{StaticResource Hint}"/>
                                <TextBlock Text="Find group" Style="{StaticResource Label}"/>
                                <DockPanel>
                                    <Button x:Name="BtnGroupSearch" DockPanel.Dock="Right" Tag="&#xE721;" Content="Search" Style="{StaticResource Ghost}" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtGroupSearch"/>
                                </DockPanel>
                                <ListBox x:Name="GroupList" MaxHeight="200" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Selected:" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SelectedGroup" Text="none"/>
                                    <Button x:Name="BtnGroupClear" Content="Clear" Style="{StaticResource Small}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Intent" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="IntentRequired" Style="{StaticResource Chip}" GroupName="Intent" Content="Required" IsChecked="True"/>
                                    <RadioButton x:Name="IntentAvailable" Style="{StaticResource Chip}" GroupName="Intent" Content="Available"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Settings ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Toolchain" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="ToolchainDetails" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="BtnToolchainUpdate" Tag="&#xE896;" Content="Check for update"/>
                                    <Button x:Name="BtnToolchainForce" Content="Re-download" Style="{StaticResource Ghost}"/>
                                    <Button x:Name="BtnToolchainFolder" Tag="&#xE838;" Style="{StaticResource Ghost}" Padding="10,9" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Sandbox and signing" Style="{StaticResource H2}"/>
                                <TextBlock Text="Workspace folder (recipes, jobs, output; takes effect after restart)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SetWorkspace"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sandbox memory (MB)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SetMemory"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="App run time in test (s)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SetTestSeconds"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Packaging timeout (min)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="SetTimeout"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Timestamp server (empty = no timestamp)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="SetTimestamp"/>
                                <CheckBox x:Name="SetVGpu" Content="Use GPU in the sandbox (vGPU)"/>
                                <CheckBox x:Name="SetNetworking" Content="Network access while packaging (needed for web installers)"/>
                                <Button x:Name="BtnSettingsSave" Tag="&#xE74E;" Content="Save settings" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Activity log -->
            <Border Grid.Row="3" Background="#080C18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="32,8,32,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnLogClear" Content="Clear" Style="{StaticResource Small}"/>
                            <Button x:Name="BtnLogToggle" Content="Hide" Style="{StaticResource Small}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="ACTIVITY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="LogList" Style="{StaticResource LogList}" Height="120" Margin="32,0,32,10"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
