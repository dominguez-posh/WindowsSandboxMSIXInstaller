<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSIX Sandbox Studio" Width="1280" Height="900" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" AllowDrop="True">
    <!-- Styles and colors: UI\Theme.xaml (same look as the M365 MFA Administration tool) -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header: title with subtitle and connection state on the left, actions on the right -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MSIX Sandbox Studio" Foreground="White" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Repackage, record and update MSIX packages in Windows Sandbox" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtConnectionStatus" Text="Not signed in to Intune" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="·" Foreground="#64748B" FontSize="12" Margin="8,0"/>
                        <TextBlock x:Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="·" Foreground="#64748B" FontSize="12" Margin="8,0"/>
                        <TextBlock x:Name="TxtSandboxState" Text="Sandbox idle" Foreground="#CBD5E1" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMode" Tag="&#xE8AB;" Content="MSIX" Style="{StaticResource HeaderButton}" ToolTip="Switch between MSIX packages and Win32 apps (.intunewin)"/>
                    <Button x:Name="BtnHelp" Tag="&#xE897;" Content="Help" Style="{StaticResource HeaderButton}"/>
                    <Button x:Name="BtnHeaderSettings" Tag="&#xE713;" Content="Settings" Style="{StaticResource HeaderButton}"/>
                    <Button x:Name="BtnIntuneSignIn" Tag="&#xE77B;" Content="Sign in" Style="{StaticResource SplitMainButton}" ToolTip="Sign in with your Microsoft account (Windows sign-in dialog)"/>
                    <Button x:Name="BtnIntuneSignInMenu" Style="{StaticResource SplitDropButton}" ToolTip="More sign-in options (Keevault)"/>
                    <Button x:Name="BtnIntuneSignOut" Tag="&#xE7E8;" Content="Sign out" Style="{StaticResource HeaderButton}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation + busy indicator -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavTab}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True"/>
                    <RadioButton x:Name="NavRecipes" Style="{StaticResource NavTab}" Tag="&#xE8FD;" Content="Recipes"/>
                    <RadioButton x:Name="NavPackages" Style="{StaticResource NavTab}" Tag="&#xE7B8;" Content="Packages"/>
                    <RadioButton x:Name="NavCertificate" Style="{StaticResource NavTab}" Tag="&#xEB95;" Content="Certificate"/>
                    <RadioButton x:Name="NavWin32Apps" Style="{StaticResource NavTab}" Tag="&#xE943;" Content="Win32 apps"/>
                    <RadioButton x:Name="NavWin32Builds" Style="{StaticResource NavTab}" Tag="&#xE7B8;" Content="Win32 builds"/>
                    <RadioButton x:Name="NavIntune" Style="{StaticResource NavTab}" Tag="&#xE753;" Content="Intune"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" Tag="&#xE713;" Content="Settings"/>
                </StackPanel>
                <StackPanel x:Name="BusyPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Style="{StaticResource Spinner}" Width="18" Height="18" StrokeThickness="2.5" Margin="0,0,10,0">
                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="BusyText" Text="Working ..." VerticalAlignment="Center" Foreground="{StaticResource Primary}" FontWeight="SemiBold"
                               MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Row="2" Margin="20,18,20,0">

            <!-- ===== Dashboard ===== -->
            <ScrollViewer x:Name="PageDashboard" Style="{StaticResource PageScroll}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Win32 mode -->
                        <GroupBox x:Name="GrpStartWin32" Header="Get started: Win32 app (.intunewin)" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Design" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="New Win32 app: choose the installer. Install, uninstall, detection and update scripts are generated and can be edited; detection by script, MSI product code, file or registry." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Test in the sandbox" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="The Win32 Test Lab runs Install, Detect, Uninstall with one click each, as SYSTEM like Intune. For an update, the previous version is installed first. Fix scripts right there, then report success or failure." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="3" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Build and document" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Creates the .intunewin, the parameter file intune-app.json with all Intune settings and the HTML documentation with the test protocol." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="4" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Publish" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="The publish wizard uploads the app to Intune, sets the app it supersedes (previous version) and the assignment." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="BtnDashWin32New" Tag="&#xE710;" Content="New Win32 app"/>
                                    <Button x:Name="BtnDashWin32Builds" Tag="&#xE7B8;" Content="Builds" Style="{StaticResource SecondaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <!-- MSIX mode -->
                        <GroupBox x:Name="GrpStartMsix" Header="Get started: MSIX package">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Signing certificate" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Create or import the certificate on the Certificate tab. Its subject becomes the publisher of every package." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Record or convert" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Record installation: a sandbox opens with the MSIX Recorder, you click Start recording, install, Stop recording. Every click is documented. For silent installers, use a recipe instead." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="3" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Test and document" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Packages are signed here, tested in a clean sandbox and documented in an HTML report with every click and the full file list." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource StepDot}"><TextBlock Text="4" Style="{StaticResource StepNumber}"/></Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Publish and update" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Text="Upload to Intune. For a new version, choose the package and click Update: its installed state is restored in the sandbox and you run the updates." Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="BtnDashRecord" Tag="&#xE7C8;" Content="Record installation"/>
                                    <Button x:Name="BtnDashNewRecipe" Tag="&#xE710;" Content="New recipe" Style="{StaticResource SecondaryButton}"/>
                                    <Button x:Name="BtnDashSandbox" Tag="&#xE7F4;" Content="Open sandbox" Style="{StaticResource SecondaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <DockPanel Grid.Column="2">
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,-12,0">
                                <Border Style="{StaticResource TileCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="StatLabel1" Text="Recipes" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="StatRecipes" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TileCard}">
                                    <StackPanel>
                                        <TextBlock x:Name="StatLabel2" Text="Packages in output" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="StatPackages" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <GroupBox Header="Readiness of this computer">
                                <StackPanel x:Name="ReadinessGrid" Margin="0,-8,0,-8"/>
                            </GroupBox>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Recipes ===== -->
            <Grid x:Name="PageRecipes" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Recipes">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnRecipeNew" Tag="&#xE710;" Content="New" Margin="0,0,4,0"/>
                            <Button x:Name="BtnRecipeRefresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                            <TextBlock Text="Tip: drop an .msi or .exe anywhere on this window to start a recipe." Style="{StaticResource Hint}"/>
                        </Border>
                        <ListBox x:Name="RecipeList" Style="{StaticResource MethodList}"/>
                    </DockPanel>
                </GroupBox>
                <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <GroupBox>
                            <GroupBox.Header>
                                <DockPanel>
                                    <Border x:Name="FrameworkBadge" DockPanel.Dock="Right" Style="{StaticResource ChipBorder}" Visibility="Collapsed">
                                        <TextBlock x:Name="FrameworkText" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="RecipeEditorTitle" Text="New recipe"/>
                                </DockPanel>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Installation" Style="{StaticResource Label}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton x:Name="ModeSilent" GroupName="InstallMode" Content="Silent (unattended)" IsChecked="True"/>
                                    <RadioButton x:Name="ModeManual" GroupName="InstallMode" Content="Manual (record my installation)"/>
                                </StackPanel>
                                <Border x:Name="ManualInfo" Style="{StaticResource InfoBox}" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="A sandbox opens with the MSIX Recorder and installs everything by itself. Click Start recording there (your installer starts automatically), install and configure the app, click Stop recording: the package is built, signed and documented click by click."/>
                                </Border>
                                <TextBlock x:Name="LblInstaller" Text="Installer (.msi / .exe)" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnRecipeBrowse" DockPanel.Dock="Right" Tag="&#xE838;" Content="Browse" Style="{StaticResource SecondaryButton}"/>
                                    <TextBox x:Name="TxtInstaller" Margin="0,4"/>
                                </DockPanel>
                                <StackPanel x:Name="ArgumentsPanel">
                                    <TextBlock Text="Silent arguments (EXE only; MSI runs silently by itself)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                    <TextBox x:Name="TxtArguments" FontFamily="Consolas"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Package name (identity)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtPackageName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Version (x.x.x.x)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtVersion"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Display name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtDisplayName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Publisher display name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtPublisherDisplay"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Description" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtDescription"/>
                                <TextBlock Text="Install location (optional, e.g. C:\Program Files\Vendor\App)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtInstallLocation"/>
                                <TextBlock x:Name="TxtPublisherHint" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnRecipeSave" Tag="&#xE74E;" Content="Save" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                    <Button x:Name="BtnRecipeDelete" Tag="&#xE74D;" Content="Delete" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Build">
                            <StackPanel>
                                <TextBlock x:Name="BuildHint" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Saves the recipe, then runs the steps unattended. Each sandbox closes by itself when it is done."/>
                                <WrapPanel>
                                    <Button x:Name="BtnBuild" Tag="&#xE7B8;" Content="Package + sign" Margin="0,0,4,4"/>
                                    <Button x:Name="BtnBuildTest" Tag="&#xEBE8;" Content="Package + sign + test" Style="{StaticResource SuccessButton}" Margin="4,0,4,4"/>
                                    <Button x:Name="BtnBuildAll" Tag="&#xE898;" Content="Full pipeline to Intune" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Packages ===== -->
            <Grid x:Name="PagePackages" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Packages">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnPkgRefresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button x:Name="BtnPkgAdd" Tag="&#xE710;" Content="Add .msix" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="BtnPkgFolder" Tag="&#xE838;" Content="Folder" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                        <ListBox x:Name="PackageList" Style="{StaticResource MethodList}"/>
                    </DockPanel>
                </GroupBox>
                <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <GroupBox>
                            <GroupBox.Header><TextBlock x:Name="PkgTitle" Text="Select a package"/></GroupBox.Header>
                            <StackPanel>
                                <TextBox x:Name="PkgDetails" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="BtnPkgTest" Tag="&#xEBE8;" Content="Test in sandbox" Style="{StaticResource SuccessButton}" Margin="0,0,4,4" IsEnabled="False"/>
                                    <Button x:Name="BtnPkgUpdate" Tag="&#xE777;" Content="Update (record new version)" Margin="4,0,4,4" IsEnabled="False"
                                            ToolTip="Restores this package in a sandbox, then you run the updates while the MSIX Recorder records"/>
                                    <Button x:Name="BtnPkgDoc" Tag="&#xE8A5;" Content="Documentation" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                                    <Button x:Name="BtnPkgSign" Tag="&#xEB95;" Content="Sign again" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                                    <Button x:Name="BtnPkgPublish" Tag="&#xE898;" Content="Publish to Intune" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="TestCard" Visibility="Collapsed">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TestIcon" Style="{StaticResource Glyph}"/>
                                    <TextBlock Text="Last test"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock x:Name="TestMessage" TextWrapping="Wrap"/>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="4" Margin="0,12,0,0">
                                    <Image x:Name="TestShot" MaxHeight="420" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnTestPrevShot" Content="&#x25C0;" Style="{StaticResource SmallButton}" Margin="0"/>
                                    <TextBlock x:Name="TestShotLabel" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="10,0"/>
                                    <Button x:Name="BtnTestNextShot" Content="&#x25B6;" Style="{StaticResource SmallButton}"/>
                                    <Button x:Name="BtnTestJob" Tag="&#xE838;" Content="Job folder" Style="{StaticResource SmallButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Win32 apps (designer) ===== -->
            <Grid x:Name="PageWin32Apps" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Win32 apps">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnW32New" Tag="&#xE710;" Content="New" Margin="0,0,4,0"/>
                            <Button x:Name="BtnW32Refresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                        <ListBox x:Name="Win32AppList" Style="{StaticResource MethodList}"/>
                    </DockPanel>
                </GroupBox>
                <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <GroupBox>
                            <GroupBox.Header><TextBlock x:Name="W32Title" Text="New Win32 app"/></GroupBox.Header>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Display name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Publisher" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32Publisher"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Version" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32Version"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Description" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtW32Description"/>
                                <TextBlock Text="Installer (.msi / .exe; optional for script-only apps)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnW32Browse" DockPanel.Dock="Right" Tag="&#xE838;" Content="Browse" Style="{StaticResource SecondaryButton}"/>
                                    <TextBox x:Name="TxtW32Installer" Margin="0,4"/>
                                </DockPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Silent arguments (EXE)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32Args" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Name in Programs and Features (for detection and uninstall)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32DetectName"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Scripts">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnW32Generate" Tag="&#xE945;" Content="Generate from templates" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="ChkW32Update" Content="Include update routine (Update.ps1, runs at the start of the installation)"/>
                                </StackPanel>
                                <TabControl x:Name="W32ScriptTabs" Height="300">
                                    <TabItem Header="Install.ps1"><TextBox x:Name="TxtW32Install" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="6"/></TabItem>
                                    <TabItem Header="Detect.ps1"><TextBox x:Name="TxtW32Detect" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="6"/></TabItem>
                                    <TabItem Header="Uninstall.ps1"><TextBox x:Name="TxtW32Uninstall" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="6"/></TabItem>
                                    <TabItem Header="Update.ps1"><TextBox x:Name="TxtW32UpdateScript" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Padding="6"/></TabItem>
                                </TabControl>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Install command: powershell (64-bit via sysnative) -File .\Install.ps1, uninstall the same with Uninstall.ps1. Logs go to the Intune Management Extension log folder."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Detection rule">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="W32DetScript" GroupName="W32Det" Content="Script (Detect.ps1)" IsChecked="True"/>
                                    <RadioButton x:Name="W32DetMsi" GroupName="W32Det" Content="MSI product code"/>
                                    <RadioButton x:Name="W32DetFile" GroupName="W32Det" Content="File or folder"/>
                                    <RadioButton x:Name="W32DetReg" GroupName="W32Det" Content="Registry"/>
                                </StackPanel>
                                <Grid x:Name="W32DetMsiPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Product code" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32ProductCode" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Minimum version (optional)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32ProductVersion"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="W32DetFilePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Folder (e.g. %ProgramFiles%\Contoso)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32FilePath"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="File or folder name" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32FileName"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Minimum file version (optional)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32FileVersion"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="W32DetRegPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Key (e.g. HKEY_LOCAL_MACHINE\SOFTWARE\Contoso)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32RegKey"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Value name (optional)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32RegValue"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Equals (optional; empty = exists)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="TxtW32RegData"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Intune settings">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Install behavior" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="CmbW32RunAs" SelectedIndex="0"><ComboBoxItem Content="system"/><ComboBoxItem Content="user"/></ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Device restart" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="CmbW32Restart" SelectedIndex="0"><ComboBoxItem Content="basedOnReturnCode"/><ComboBoxItem Content="suppress"/><ComboBoxItem Content="allow"/><ComboBoxItem Content="force"/></ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Architecture" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="CmbW32Arch" SelectedIndex="0"><ComboBoxItem Content="x64,x86"/><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/></ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Minimum Windows" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="CmbW32MinOS" SelectedIndex="0"><ComboBoxItem Content="1607"/><ComboBoxItem Content="1809"/><ComboBoxItem Content="2004"/><ComboBoxItem Content="21H2"/><ComboBoxItem Content="22H2"/></ComboBox>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Test and build">
                            <StackPanel>
                                <Border x:Name="W32LastTestBox" Style="{StaticResource InfoBox}" Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtW32LastTest" TextWrapping="Wrap" FontSize="12" Text="Not tested yet."/>
                                </Border>
                                <WrapPanel>
                                    <Button x:Name="BtnW32Save" Tag="&#xE74E;" Content="Save" Style="{StaticResource SecondaryButton}" Margin="0,0,4,4"/>
                                    <Button x:Name="BtnW32Test" Tag="&#xEBE8;" Content="Test in sandbox" Style="{StaticResource SuccessButton}" Margin="4,0,4,4"
                                            ToolTip="Win32 Test Lab: Install, Detect, Uninstall with one click each"/>
                                    <Button x:Name="BtnW32TestUpdate" Tag="&#xE777;" Content="Test update from previous build ..." Style="{StaticResource SuccessButton}" Margin="4,0,4,4"
                                            ToolTip="Installs a previous build first, then the update"/>
                                    <Button x:Name="BtnW32Build" Tag="&#xE7B8;" Content="Build .intunewin" Margin="4,0,4,4"/>
                                    <Button x:Name="BtnW32Delete" Tag="&#xE74D;" Content="Delete" Style="{StaticResource DangerButton}" Margin="4,0,4,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Win32 builds ===== -->
            <Grid x:Name="PageWin32Builds" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <GroupBox Header="Built packages (.intunewin)">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnW32BuildsRefresh" Tag="&#xE72C;" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                            <Button x:Name="BtnW32BuildsFolder" Tag="&#xE838;" Content="Folder" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                        <ListBox x:Name="Win32BuildList" Style="{StaticResource MethodList}"/>
                    </DockPanel>
                </GroupBox>
                <ScrollViewer Grid.Column="2" Style="{StaticResource PageScroll}">
                    <GroupBox>
                        <GroupBox.Header><TextBlock x:Name="W32BuildTitle" Text="Select a build"/></GroupBox.Header>
                        <StackPanel>
                            <TextBox x:Name="W32BuildDetails" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="BtnW32Publish" Tag="&#xE898;" Content="Publish to Intune ..." Margin="0,0,4,4" IsEnabled="False"/>
                                <Button x:Name="BtnW32BuildDoc" Tag="&#xE8A5;" Content="Documentation" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                                <Button x:Name="BtnW32BuildParams" Tag="&#xE943;" Content="Parameter file" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                                <Button x:Name="BtnW32BuildOpen" Tag="&#xE838;" Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="4,0,4,4" IsEnabled="False"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </ScrollViewer>
            </Grid>

            <!-- ===== Certificate ===== -->
            <ScrollViewer x:Name="PageCertificate" Visibility="Collapsed" Style="{StaticResource PageScroll}">
                <StackPanel>
                    <GroupBox Header="Signing certificate">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CertSubject" Text="No certificate" FontSize="16" FontWeight="SemiBold"/>
                                <TextBox x:Name="CertDetails" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnCertFolder" Tag="&#xE838;" Content="Folder" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnCertIntune" Tag="&#xE753;" Content="Trust via Intune"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Create self-signed">
                            <StackPanel>
                                <TextBlock Text="Subject = publisher of all packages" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtCertSubject" Text="CN="/>
                                <TextBlock Text="Valid for (years)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtCertYears" Text="5"/>
                                <TextBlock Text="PFX password" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="PwdCertNew"/>
                                <TextBlock Text="Repeat password" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="PwdCertNew2"/>
                                <Button x:Name="BtnCertCreate" Tag="&#xE710;" Content="Create" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Import PFX">
                            <StackPanel>
                                <TextBlock Text="Internal CA, public CA or an earlier certificate" Style="{StaticResource Hint}"/>
                                <TextBlock Text="PFX file" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <DockPanel>
                                    <Button x:Name="BtnCertBrowse" DockPanel.Dock="Right" Tag="&#xE838;" Style="{StaticResource SecondaryButton}" Padding="10,8"/>
                                    <TextBox x:Name="TxtCertPfx" Margin="0,4"/>
                                </DockPanel>
                                <TextBlock Text="PFX password" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="PwdCertImport"/>
                                <Button x:Name="BtnCertImport" Tag="&#xE896;" Content="Import" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="4" Header="Azure Key Vault">
                            <StackPanel>
                                <TextBlock Text="Needs Az.KeyVault; the sign-in appears in front of this window" Style="{StaticResource Hint}"/>
                                <TextBlock Text="Vault name" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtKvVault"/>
                                <TextBlock Text="Certificate name" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TxtKvCert"/>
                                <TextBlock Text="Local PFX password" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="PwdKv"/>
                                <Button x:Name="BtnCertKv" Tag="&#xE753;" Content="Fetch" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <Border Style="{StaticResource InfoBox}" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="The private key stays on this computer: packages are signed here, sandboxes only get the public .cer. The PFX password is stored DPAPI-encrypted for your Windows account."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Intune ===== -->
            <ScrollViewer x:Name="PageIntune" Visibility="Collapsed" Style="{StaticResource PageScroll}">
                <StackPanel>
                    <GroupBox Header="Connection">
                        <StackPanel>
                            <TextBlock x:Name="IntuneAccount" Text="Not signed in" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="IntuneTenant" Style="{StaticResource Hint}" Margin="0,4,0,10"/>
                            <TextBlock Text="Tenant (optional: ID or domain, e.g. for guest accounts)" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <Button x:Name="BtnIntunePageSignInMenu" DockPanel.Dock="Right" Style="{StaticResource SplitDropButton}" ToolTip="More sign-in options (Keevault)"/>
                                <Button x:Name="BtnIntunePageSignIn" DockPanel.Dock="Right" Tag="&#xE77B;" Content="Sign in" Style="{StaticResource SplitMainButton}"/>
                                <TextBox x:Name="TxtTenantId" Margin="0,4"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Assignment for published apps">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Optional. Without a group the app is uploaded but not assigned. Assigning replaces the app's existing assignments."/>
                            <TextBlock Text="Find group" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button x:Name="BtnGroupSearch" DockPanel.Dock="Right" Tag="&#xE721;" Content="Search"/>
                                <TextBox x:Name="TxtGroupSearch" Margin="0,4"/>
                            </DockPanel>
                            <ListBox x:Name="GroupList" Style="{StaticResource MethodList}" MaxHeight="220" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Selected:" Foreground="{StaticResource MutedText}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SelectedGroup" Text="none" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="BtnGroupClear" Content="Clear" Style="{StaticResource SmallButton}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Intent" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="IntentRequired" GroupName="Intent" Content="Required" IsChecked="True"/>
                                <RadioButton x:Name="IntentAvailable" GroupName="Intent" Content="Available"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Settings ===== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" Style="{StaticResource PageScroll}">
                <StackPanel>
                    <GroupBox Header="Toolchain">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ToolchainDetails" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnToolchainUpdate" Tag="&#xE896;" Content="Check for update"/>
                                <Button x:Name="BtnToolchainForce" Content="Re-download" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnToolchainFolder" Tag="&#xE838;" Style="{StaticResource SecondaryButton}" Padding="10,8"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Sandbox and signing">
                        <StackPanel>
                            <TextBlock Text="Workspace folder (recipes, jobs, output; takes effect after restart)" Style="{StaticResource Label}"/>
                            <TextBox x:Name="SetWorkspace"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sandbox memory (MB)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="SetMemory"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="App run time in test (s)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="SetTestSeconds"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Packaging timeout (min)" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="SetTimeout"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Timestamp server (empty = no timestamp)" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                            <TextBox x:Name="SetTimestamp"/>
                            <CheckBox x:Name="SetVGpu" Content="Use GPU in the sandbox (vGPU)" Margin="0,12,0,0"/>
                            <CheckBox x:Name="SetNetworking" Content="Network access while packaging and recording (needed for web installers)" Margin="0,8,0,0"/>
                            <Button x:Name="BtnSettingsSave" Tag="&#xE74E;" Content="Save settings" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Activity log -->
        <GroupBox Grid.Row="3" Margin="20,4,20,0" Padding="8,4">
            <GroupBox.Header>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="BtnLogClear" Content="Clear" Style="{StaticResource SmallButton}"/>
                        <Button x:Name="BtnLogToggle" Content="Hide" Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                    <TextBlock Text="Activity" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox.Header>
            <ListBox x:Name="LogList" Style="{StaticResource LogList}" Height="88"/>
        </GroupBox>

        <TextBlock Grid.Row="4" x:Name="FooterText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedText}"
                   Text="Packages are signed on this computer. Sandboxes only receive the public certificate."/>

        <!-- Help flyout -->
        <Border x:Name="HelpPanel" Grid.Row="1" Grid.RowSpan="4" Style="{StaticResource HelpPanel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnHelpClose" DockPanel.Dock="Right" Style="{StaticResource CloseButton}"/>
                    <TextBlock x:Name="HelpTitle" Text="Help" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel x:Name="HelpBody"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
