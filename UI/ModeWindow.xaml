<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSIX Sandbox Studio" Width="760" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <!-- Start question: what do you want to build? -->
    <StackPanel>
        <Border Background="{StaticResource HeaderBackground}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="What do you want to build?" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="You can switch at any time with the button in the header." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Grid Margin="16,18,16,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="BtnChooseMsix" Cursor="Hand" Foreground="{StaticResource Text}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="18,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Primary}"/>
                    <TextBlock Text="MSIX package" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="12"
                               Text="Repackage an installer into a signed MSIX: unattended or recorded click by click in the sandbox, tested, documented, published to Intune."/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnChooseWin32" Grid.Column="2" Cursor="Hand" Foreground="{StaticResource Text}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="18,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#EAF2FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource Primary}"/>
                    <TextBlock Text="Win32 app (.intunewin)" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="12"
                               Text="Design install, uninstall, detection and update scripts, test Install / Detect / Uninstall (and updates) in the sandbox, build the .intunewin and publish it with supersedence."/>
                </StackPanel>
            </Button>
        </Grid>
        <CheckBox x:Name="ChkModeRemember" Content="Do not ask again at start" Margin="22,4,22,18"/>
    </StackPanel>
</Window>
